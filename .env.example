# .env.example — copy to .env and fill in real values. NEVER commit .env.

# Supabase project URL (from Settings → API in the Supabase dashboard)
SUPABASE_URL=https://your-project-ref.supabase.co

# Service Role key (from Settings → API → service_role). Server-side ONLY.
# This key bypasses RLS. Never expose it to the browser.
SUPABASE_SERVICE_KEY=your-service-role-key-here

# Shared admin API key for Bearer token auth. Must be 32+ characters.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Rotate this value and redeploy to invalidate all existing sessions.
FLEET_API_KEY=change-me-to-a-random-string-of-at-least-32-characters

# The exact origin of your frontend (no trailing slash).
# Must match the domain serving fleetmis.html in production.
# e.g. https://your-org.github.io or https://fleet.netlify.app
ALLOWED_ORIGIN=http://localhost:5500
